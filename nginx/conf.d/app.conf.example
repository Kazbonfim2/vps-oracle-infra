# Exemplo de configuracao de Proxy Reverso com HTTPS para uma aplicacao
# Copie este arquivo para o nome da sua aplicacao (ex: app1.meudominio.com.conf)

# 1. Redirecionamento HTTP -> HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name app1.meudominio.com;

    # Validacao Let's Encrypt ACME
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Redireciona todo o restante para HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

# 2. Servidor HTTPS seguro
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name app1.meudominio.com;

    # Certificados SSL gerados pelo Certbot
    ssl_certificate /etc/letsencrypt/live/app1.meudominio.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/app1.meudominio.com/privkey.pem;

    # Parametros SSL seguros (Mozilla Intermediate)
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # Headers de seguranca
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Limite de upload (ajuste conforme necessario)
    client_max_body_size 50M;

    # Proxy para o container da aplicacao na rede proxy-net
    location / {
        # Nome do container da aplicacao e porta interna
        proxy_pass http://nome-do-container:3000;

        # Repasse de headers reais do cliente
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 90;
    }
}
