# Configuracao de Proxy Reverso com HTTPS para o Portainer usando sslip.io
# Copie para nginx/conf.d/portainer.137.131.172.167.sslip.io.conf

# 1. Redirecionamento HTTP -> HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name portainer.137.131.172.167.sslip.io;

    # Validacao ACME Let's Encrypt
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# 2. Servidor HTTPS seguro
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name portainer.137.131.172.167.sslip.io;

    # Certificados Let's Encrypt
    ssl_certificate /etc/letsencrypt/live/portainer.137.131.172.167.sslip.io/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/portainer.137.131.172.167.sslip.io/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    # Proxy para o container do Portainer (porta 9000 interna na rede proxy-net)
    location / {
        proxy_pass http://portainer:9000;
        proxy_http_version 1.1;

        # Suporte a WebSockets (obrigatorio para console e terminal do Portainer)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
